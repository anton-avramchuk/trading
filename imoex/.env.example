# Database
DATABASE_URL=postgresql+asyncpg://trading_user:trading_password@db:5432/trading

# MOEX API
MOEX_BASE_URL=https://iss.moex.com/iss
MOEX_RATE_LIMIT=10
MOEX_TIMEOUT=30
MOEX_MAX_RETRIES=3

# Service
SERVICE_NAME=imoex
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://redis:6379/1
CACHE_TTL=3600

# Scheduler
ENABLE_SCHEDULER=false
UPDATE_SCHEDULE="0 19 * * 1-5"
UPDATE_TIMEFRAMES=1d,1h
UPDATE_DAYS_BACK=3
